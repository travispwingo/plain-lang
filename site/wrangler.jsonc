{
  // plain-lang.dev: a static site served by a Worker with assets only (no Worker script),
  // so site/dist/_headers applies to every response.
  "name": "plain-lang-dev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "plain-lang.dev", "custom_domain": true },
    { "pattern": "www.plain-lang.dev", "custom_domain": true }
  ]
}
